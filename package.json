{
  "name": "afro-fashion-main",
  "version": "1.0.0",
  "description": "",
  "main": "index.tsx",
  "scripts": {
    "install:client": "cd af-client && npm install",
    "install:server": "cd af-server && npm install",
    "install": "npm-run-all install:client install:server",
    "client": "cd af-client && npm start",
    "server": "cd af-server && nodemon --exec ts-node server.ts",
    "dev": "npm-run-all --parallel client server",
    "build:client": "cd af-client && npm run build",
    "build:server": "cd af-server && npm run build",
    "build": "npm-run-all --parallel build:client build:server"
  },
